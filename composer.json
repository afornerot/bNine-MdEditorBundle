{
    "name": "bnine/mdeditorbundle",
    "description": "Symfony bundle providing an EasyMDE Markdown form type and its assets",
    "type": "symfony-bundle",
    "license": "MIT",
    "keywords": [
        "symfony",
        "bundle",
        "markdown",
        "editor",
        "easymde",
        "form"
    ],
    "authors": [
        {
            "name": "afornerot",
            "email": "arno.nanor@gmail.com"
        }
    ],
    "autoload": {
        "psr-4": {
            "Bnine\\MdEditorBundle\\": "src/"
        }
    },
    "require": {
        "php": "^8.1",
        "league/commonmark": "^2.7",
        "symfony/form": "^7.1",
        "symfony/framework-bundle": "^7.1",
        "twig/markdown-extra": "^3.0",
        "twig/twig": "^3.12"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.85"
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.0-dev"
        }
    }
}
